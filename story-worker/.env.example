# Supabase (hosted: Project Settings > API). Service role key, never the anon key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# LLM: meta (default, muse-spark-1.3), openai, anthropic or codex
LLM_PROVIDER=meta
LLM_MODEL=
META_API_KEY=
# Base URL, /chat/completions is appended. Default https://api.meta.ai/v1
META_API_URL=
META_REASONING_EFFORT=low
# Only needed if LLM_PROVIDER is openai or anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only needed if LLM_PROVIDER is codex (see ../codex-relay/README.md)
CODEX_RELAY_URL=
CODEX_RELAY_SECRET=

# Luma (LUMA_API_STYLE=agents for luma-api- keys, dream_machine for the old API)
LUMA_API_KEY=
LUMA_API_STYLE=agents
LUMA_API_URL=https://agents.lumalabs.ai/v1
LUMA_GENERATIONS_ENDPOINT=
LUMA_MODEL=ray-3.2
LUMA_ASPECT_RATIO=21:9
LUMA_RESOLUTION=540p
LUMA_DURATION=5s
LUMA_POLL_INTERVAL=5
LUMA_TIMEOUT=240

# ffmpeg look. Dream Recorder used 0.2 / 2 / 300 / 100 / 40 for ray-flash-2; ray-3.2 footage is cleaner and warmer, so these lighter values keep detail
FFMPEG_BRIGHTNESS=0.03
FFMPEG_VIBRANCE=0.25
FFMPEG_DENOISE_THRESHOLD=20
FFMPEG_BILATERAL_SIGMA=12
FFMPEG_NOISE_STRENGTH=34

# Worker loop
POLL_SECONDS=5
CLAIM_STALE_MINUTES=10

# Video
LUMA_RETRIES=2
SCENES=5
LUMA_CONCURRENCY=4
LUMA_SLOWDOWN=2.0
STORY_FALLBACK=none
