# Edge function secrets. Copy to backend/.env, fill in, never commit .env.
# Used by `supabase functions serve --env-file .env` locally and
# `supabase secrets set --env-file .env` for a hosted project.
ELEVENLABS_API_KEY=
META_API_KEY=
# Only needed if a provider below is switched to openai or anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Speech to text: elevenlabs (Scribe, default) | openai
STT_PROVIDER=elevenlabs
# Empty means the provider default (elevenlabs scribe_v2, openai gpt-4o-transcribe)
STT_MODEL=
# meta (Muse Spark, default) | openai | anthropic | codex
LLM_PROVIDER=meta
# Empty means the provider default (meta muse-spark-1.3, openai gpt-4o, anthropic claude-opus-5-5)
LLM_MODEL=
# Images for make-story: meta (Muse Image, default) | openai | codex
IMAGE_PROVIDER=meta
# Only for the codex provider: relay base URL (ends in /v1) and its RELAY_SECRET. See codex-relay/README.md
CODEX_RELAY_URL=
CODEX_RELAY_SECRET=
# Empty means the provider default (meta muse-image-1.0, openai gpt-image-1)
IMAGE_MODEL=
TTS_MODEL=eleven_multilingual_v2
# Voice settings for every TTS call. Defaults below; empty keeps the default.
TTS_STABILITY=0.45
TTS_SIMILARITY=0.85
TTS_STYLE=0.15
TTS_SPEAKER_BOOST=true
# Stock ElevenLabs voice used before a profile has enrolled its own voice
FALLBACK_VOICE_ID=
# Meta Model API base URL. Empty means https://api.meta.ai/v1
META_API_URL=
# Muse Spark reasoning effort, low keeps latency down
META_REASONING_EFFORT=low

# Smoke test only, not function secrets. SUPABASE_ prefixed names are rejected by
# `supabase secrets set`, so keep these in your shell or a separate file.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
